Open Nunction Main()
{
    Print("--- Basic For ---");
    For (Int i = 0; i < 10; i++)
    {
        Print(i);
    }

    Print("--- Zero Iterations ---");
    For (Int i = 0; i < 0; i++)
    {
        Print("FAIL: should not execute");
    }

    Print("--- Decrement ---");
    For (Int i = 3; i > 0; i--)
    {
        Print(i);
    }

    Print("--- Nested ---");
    For (Int i = 0; i < 2; i++)
    {
        For (Int j = 0; j < 2; j++)
        {
            Int val = i * 10 + j;
            Print(val);
        }
    }

    Print("--- Modified Inside ---");
    For (Int i = 0; i < 5; i++)
    {
        Print(i);
        i = i + 1;
    }

    Print("done");
}
