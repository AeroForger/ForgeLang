Open Nunction Main()
{
    Number Int x = 10;

    If (x < 20)
    {
        Print("yes");
    }
    Else
    {
        Print("no");
    }

    If (x == 99)
    {
        Print("never");
    }
    Else If (x == 10)
    {
        Print("else-if works");
    }
    Else
    {
        Print("nope");
    }

    If (x == 10 Or x == 5)
    {
        Print("or works");
    }

    If (x > 100)
    {
        Print("never either");
    }

    If (x == 10 And x < 20)
    {
        Print("and works");
    }

    If (x == 99)
    {
        Print("chain start");
    }
    Else If (x == 98)
    {
        Print("chain middle");
    }
    Else If (x == 10)
    {
        Print("third branch caught it");
    }
    Else
    {
        Print("chain end");
    }

    Print("after all ifs");
}
